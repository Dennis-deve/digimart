# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/digimart?schema=public"

# Auth — create a long random secret for production
JWT_SECRET="replace-with-a-long-random-secret"

# Moolre (server-only)
MOOLRE_BASE_URL="https://api.moolre.com"
MOOLRE_API_USER=""
MOOLRE_API_PUBKEY=""
# ^ PUBLIC API key (X-API-PUBKEY) — used for collections/payments/status. NOT the private key!
# Optional, for future Moolre transfers/payouts (X-API-KEY header, PRIVATE key only):
MOOLRE_API_PRIVKEY=""
MOOLRE_ACCOUNT_NUMBER=""
MOOLRE_WEBHOOK_TOKEN="replace-with-a-long-random-callback-token"

# BundleShopGH (server-only)
BUNDLESHOPGH_BASE_URL="https://backend.mycledanet.com"
BUNDLESHOPGH_API_KEY=""
BUNDLESHOPGH_WEBHOOK_TOKEN=""

# Muviin (server-only)
MUVIIN_API_KEY=""

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Secure scheduled-job authorization
JOBS_TOKEN="replace-with-a-long-random-job-token"

# Public deployed DigiMart URL used in provider callbacks
APP_URL="https://your-digimart-domain.com"

# --- Commerce V2 ---
# Buyer pays the MoMo processing fee (shown at checkout). Defaults shown.
PAYMENT_FEE_PCT="1.95"
PAYMENT_FEE_FLAT="0"
# Platform commission on seller physical sales (percent). Default 10.
SELLER_COMMISSION_PCT="10"
# Moolre SMS (dashboard: SMS -> API/VAS key). Optional — SMS is skipped when unset.
MOOLRE_SMS_VASKEY=""
MOOLRE_SMS_SENDER="DigiMart"
# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID/secret).
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Web push (generate once: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Database move (one-time, run: npm run db:move) ---
# DB_MOVE_FROM=postgresql://...neon...   (defaults to DATABASE_URL)
# DB_MOVE_TO=postgresql://...railway...

# Refer2Bundle (data bundles provider) — https://refer2bundle.com/api/v1
REFER2BUNDLE_BASE_URL="https://refer2bundle.com/api/v1"
REFER2BUNDLE_API_KEY=""

# Moolre collection channel codes (defaults: MTN=13, Telecel=6, AT=7).
# If Moolre confirms different codes for the direct USSD-prompt (Direct Debit) flow,
# set them here — no code changes needed:
# MOOLRE_CH_MTN="13"
# MOOLRE_CH_TELECEL="6"
# MOOLRE_CH_AT="7"
