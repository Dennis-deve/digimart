# ================= DigiMart environment =================
# Copy to .env and fill. NEVER commit .env. Same values go into Railway Variables (no quotes).

# --- Database ---
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=no-verify"

# --- Auth / app ---
JWT_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
NODE_ENV="development"
APP_URL="https://digimart-production-b330.up.railway.app"

# --- Moolre payments (merchant portal) ---
MOOLRE_BASE_URL="https://api.moolre.com"
MOOLRE_API_USER="digimartgh"
MOOLRE_API_PUBKEY=""            # PUBLIC key (collections) — NOT the private key!
MOOLRE_API_PRIVKEY=""           # PRIVATE key (transfers/payouts only)
MOOLRE_ACCOUNT_NUMBER=""
MOOLRE_WEBHOOK_TOKEN=""         # long random — also in the Moolre callback URL ?token=
# Collection channel codes (defaults documented by Moolre; override if they confirm others)
# MOOLRE_CH_MTN="13"
# MOOLRE_CH_TELECEL="6"
# MOOLRE_CH_AT="7"
# Transfer channel codes (MTN=1 documented; set when Moolre confirms the rest)
# MOOLRE_TRF_TELECEL=""
# MOOLRE_TRF_AT=""
# SMS (app.moolre.com -> SMS service -> Admin -> Manage API Keys)
MOOLRE_SMS_VASKEY=""
MOOLRE_SMS_SENDER="DigiMart"

# --- Providers ---
BUNDLESHOPGH_BASE_URL="https://backend.mycledanet.com"
BUNDLESHOPGH_API_KEY=""
BUNDLESHOPGH_WEBHOOK_TOKEN=""
MUVIIN_API_KEY=""
REFER2BUNDLE_BASE_URL="https://refer2bundle.com/api/v1"
REFER2BUNDLE_API_KEY=""
# All provider calls time out after this many ms (default 15000)
PROVIDER_TIMEOUT_MS="15000"

# --- Reseller economics ---
RESELLER_REGISTRATION_FEE="50"      # fallback when PlatformSettings has no value
# --- Seller commissions ---
SELLER_DIRECT_COMMISSION_PCT="0"    # platform cut of seller sales FROM THEIR OWN store link
SELLER_COMMISSION_PCT="10"          # platform cut of seller sales on the MAIN marketplace
STORE_AFFILIATE_PCT="2"             # store-owner cut when other products sell via their link
# --- Rider economics ---
RIDER_FEE_PCT="100"                 # rider share of each delivery fee
# --- Buyer payment fee ---
PAYMENT_FEE_PCT="1.95"
PAYMENT_FEE_FLAT="0"

# --- Auto-payouts cron (minutes a payout waits before the job auto-sends it) ---
AUTO_PAYOUT_AFTER_MINUTES="60"

# --- Operations ---
JOBS_TOKEN=""                       # protects all /api/jobs endpoints (cron uses it)
ADMIN_RECOVERY_KEY=""               # admin create/promote panel on the sign-in page

# --- Cloudinary (product images / store banners) ---
STORAGE_DRIVER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Web push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Owner margin (%) added to synced provider catalog prices on import
CATALOG_MARGIN_PCT="15"

# Provider storefronts — synced products at provider price hand off to these for payment
BUNDLESHOP_STORE_URL="https://bundleshopgh.com/store/joedai"
REFER2BUNDLE_STORE_URL=""
MUVIIN_STORE_URL="https://vendor.muviin.co/#/merchant/3245-ADDAI'SBUNDLE"
