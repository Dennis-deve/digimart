# DigiMart environment template
# ------------------------------------------------------------------
# 1. Save a copy of this file as `.env` in the project root (same folder
#    as package.json). The app and Prisma both read `.env`, never this file.
# 2. `.env` is git-ignored and is NOT included in the ZIP. If you move or
#    copy the project folder, copy `.env` with it — Prisma error P1013
#    ("the scheme is not recognized") means DATABASE_URL was empty/absent.
# 3. Every value that was ever pasted into a chat is considered leaked.
#    Rotate before going live: Neon role password, JWT_SECRET, Moolre pubkey,
#    BundleShopGH API key + webhook token, Muviin key, Cloudinary secret,
#    ADMIN_RECOVERY_KEY, JOBS_TOKEN.
#
# Quotes around values are fine — dotenv strips one matching outer pair.
# Do NOT wrap a value in quotes if it is already quoted, and never paste a
# value across two lines.
# ------------------------------------------------------------------

# ---- PostgreSQL (Neon) ------------------------------------------------
# Use the POOLED connection string: Neon -> Connection Details -> Pooled.
# It must start with postgresql:// and end with /neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-neon.tech/neondb?sslmode=require&channel_binding=require"

# ---- Auth -------------------------------------------------------------
# Long random string. Rotating it signs every user out.
JWT_SECRET=""

# ---- App --------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
PUBLIC_BASE_URL="http://localhost:3000"
STORAGE_DRIVER="cloudinary"

# ---- Moolre (server-only, never expose to the browser) ----------------
MOOLRE_BASE_URL="https://api.moolre.com"
MOOLRE_API_USER=""
MOOLRE_API_PUBKEY=""
# ^ PUBLIC API key (X-API-PUBKEY) — used for collections/payments/status. NOT the private key!
# Optional, for future Moolre transfers/payouts (X-API-KEY header, PRIVATE key only):
MOOLRE_API_PRIVKEY=""
MOOLRE_ACCOUNT_NUMBER=""
MOOLRE_WEBHOOK_TOKEN=""

# ---- BundleShopGH: data bundles only (server-only) --------------------
BUNDLESHOPGH_BASE_URL="https://backend.mycledanet.com"
BUNDLESHOPGH_API_KEY=""
BUNDLESHOPGH_WEBHOOK_TOKEN=""

# ---- Muviin: airtime, result checkers, selected digital services ------
MUVIIN_API_KEY=""

# ---- Cloudinary (server-only) ----------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Admin / jobs -----------------------------------------------------
ADMIN_RECOVERY_KEY=""
JOBS_TOKEN=""

# Commerce V2: fees, commission, SMS, Google OAuth (see .env.example for notes)
PAYMENT_FEE_PCT="1.95"
PAYMENT_FEE_FLAT="0"
SELLER_COMMISSION_PCT="10"
MOOLRE_SMS_VASKEY=""
MOOLRE_SMS_SENDER="DigiMart"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Refer2Bundle (data bundles provider) — https://refer2bundle.com/api/v1
REFER2BUNDLE_BASE_URL="https://refer2bundle.com/api/v1"
REFER2BUNDLE_API_KEY=""
